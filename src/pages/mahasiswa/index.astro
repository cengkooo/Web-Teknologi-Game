---
import Layout from '../../layouts/Layout.astro';
import MahasiswaLedger from '../../components/MahasiswaLedger.astro';
import { getAllStudents, getGamesByStudentId } from '../../lib/data';

const students = getAllStudents();

// Group students with their games
const studentsWithGames = students.map((student) => ({
  student,
  games: getGamesByStudentId(student.id),
}));

// Unique cohorts sorted descending
const batches = Array.from(new Set(students.map((s) => s.batch))).sort((a, b) => b - a);
---

<Layout
  title="TEKNOLOGI GAME - INFORMATIKA ITERA"
  description="Tabel direktori induk mahasiswa Mata Kuliah Teknologi Game: pemindaian cepat nama, peran, angkatan, dan hasil karya game."
>
  <!-- Header Section -->
  <div class="border border-[#262626] bg-[#0A0A0A] p-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono">
    <div>
      <div class="flex items-center gap-2 mb-2 text-xs text-[#737373]">
        <span class="inline-block w-2 h-2 bg-white"></span>
        <span>INDEX: 03 // MAHASISWA</span>
      </div>
      <h1 class="font-display font-black text-2xl sm:text-4xl text-white tracking-wider uppercase">
        DAFTAR MAHASISWA
      </h1>
      <p class="text-xs text-[#737373] mt-1">
        Tabel induk mahasiswa Mata Kuliah Teknologi Game. Memudahkan pemindaian cepat nama, spesialisasi peran, angkatan, karya game terkait, dan portofolio kode.
      </p>
    </div>

    <div class="flex items-center gap-4 text-xs border border-[#262626] p-3 bg-black self-start sm:self-auto">
      <div>
        <span class="text-[#737373] block text-[10px]">TOTAL MAHASISWA</span>
        <span id="roster-total-count" class="text-white font-bold text-lg">{students.length}</span>
      </div>
      <div class="border-l border-[#262626] pl-4">
        <span class="text-[#737373] block text-[10px]">TAHUN</span>
        <span class="text-white font-bold text-sm">{batches.join(', ')}</span>
      </div>
    </div>
  </div>

  <!-- Interactive Master Ledger Component -->
  <MahasiswaLedger
    studentsWithGames={studentsWithGames}
    batches={batches}
    totalStudents={students.length}
  />
</Layout>
