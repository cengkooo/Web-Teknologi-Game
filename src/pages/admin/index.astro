---
// Otomatis mengalihkan /admin ke /keystatic (Keystatic CMS Dashboard)
return Astro.redirect('/keystatic');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/keystatic" />
    <title>REDIRECTING TO KEYSTATIC CMS // TEKNOLOGI GAME</title>
  </head>
  <body style="background:#000;color:#fff;font-family:monospace;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;">
    <div style="text-align:center;">
      <p style="letter-spacing:0.1em;font-weight:bold;">[MENGALIHKAN KE KEYSTATIC CMS...]</p>
      <p><a href="/keystatic" style="color:#fff;text-decoration:underline;">Klik di sini jika peramban tidak mengalihkan secara otomatis</a></p>
    </div>
  </body>
</html>
