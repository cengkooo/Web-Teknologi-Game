---
import { getSiteConfig } from '../lib/data';

interface Props {
  totalGames: number;
}

const { totalGames } = Astro.props;
const siteConfig = getSiteConfig();
---

<!-- Hero Section with Brutalist Geometric Box -->
<section class="mb-12">
  <div class="border border-[#262626] bg-[#0A0A0A] p-6 sm:p-10 relative overflow-hidden">
    <!-- Top badge -->
    <div class="flex items-center gap-2 mb-4 font-mono text-xs text-[#737373]">
      <span class="inline-block w-2 h-2 bg-white"></span>
      <span class="text-white font-bold tracking-widest uppercase">{siteConfig.institutionBadge}</span>
      <span>//</span>
      <span>{siteConfig.courseBadge}</span>
    </div>

    <!-- Hero Title in English -->
    <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-white tracking-wider uppercase mb-6 leading-none">
      CRAFTING GAMES.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#d4d4d4] to-[#737373]">
        MAKING DREAMS.
      </span><!--<br />
      TO PLAYABLE BUILDS.-->
    </h1>

    <p class="font-mono text-xs sm:text-sm text-zinc-100 max-w-3xl leading-relaxed mb-8">
      Selamat datang di etalase Mata Kuliah Teknologi Game dari Program Studi Teknik Informatika ITERA. Di sini kamu bisa melihat hasil tugas besar game dari mahasiswa mata kuliah.
      <br />
      Unduh dan mainkan kreasi mereka!
    </p>

    <!-- Action Buttons Matrix -->
    <div class="flex flex-wrap gap-3">
      <a
        href="/games"
        data-astro-prefetch="hover"
        class="px-5 py-3 bg-white text-black font-mono font-bold text-xs tracking-wider uppercase border border-white hover:bg-black hover:text-white transition-colors flex items-center gap-2"
      >
        <span>EXPLORE GAMES [{totalGames} BUILDS]</span>
        <span>&rarr;</span>
      </a>
      <a
        href="#course-story"
        class="px-5 py-3 bg-black text-white font-mono font-bold text-xs tracking-wider uppercase border border-[#262626] hover:bg-white hover:text-black transition-colors"
      >
        ABOUT THE COURSE
      </a>
      <a
        href="#collaboration"
        class="px-5 py-3 bg-black text-white font-mono font-bold text-xs tracking-wider uppercase border border-[#262626] hover:bg-white hover:text-black transition-colors"
      >
        PARTNER WITH US
      </a>
    </div>
  </div>
</section>
