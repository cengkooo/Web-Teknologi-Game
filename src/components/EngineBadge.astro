---
interface Props {
  engine: string;
  size?: 'sm' | 'md';
}

const { engine, size = 'sm' } = Astro.props;

// Formatting to bracketed technical tag [UNITY], [GODOT], etc.
const formatted = engine.toUpperCase();
---

<span
  class={`inline-flex items-center font-mono font-bold tracking-wider uppercase border border-[#262626] bg-black text-[#A3A3A3] group-hover:border-white group-hover:text-white transition-colors ${
    size === 'sm' ? 'px-1.5 py-0.5 text-[10px]' : 'px-2.5 py-1 text-xs'
  }`}
>
  [{formatted}]
</span>
