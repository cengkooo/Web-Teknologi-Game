---
import type { ExpoPhoto } from '../types';

interface GalleryPhoto extends ExpoPhoto {
  eventId: string;
  eventTitle: string;
  eventYear: number;
  eventDate: string;
  location: string;
}

interface Props {
  photos: GalleryPhoto[];
  years: number[];
}

const { photos, years } = Astro.props;
---

<!-- Photo Gallery Section with Dynamic Filters -->
<section class="mb-14" id="photo-gallery">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-6 border-b border-[#262626] gap-3">
    <div class="flex items-center gap-2 font-mono text-xs">
      <span class="inline-block w-2 h-2 bg-white"></span>
      <h2 class="font-display font-bold text-lg sm:text-xl tracking-wider text-white uppercase">
        GALERI DOKUMENTASI DUNIA NYATA
      </h2>
    </div>
    <div class="font-mono text-xs text-[#737373]">
      MENAMPILKAN <span id="gallery-counter" class="text-white font-bold">{photos.length}</span> DARI {photos.length} FOTO
    </div>
  </div>

  <!-- Filter Buttons Bar (Hanya Tahun) -->
  <div class="border border-[#262626] bg-[#0A0A0A] p-4 mb-8 font-mono text-xs">
    <!-- Filter Tahun -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[#737373] text-[10px] uppercase tracking-wider mr-2 font-bold">// TAHUN:</span>
      <button
        class="year-filter-btn px-3 py-1 text-xs border border-white bg-white text-black font-bold uppercase transition-colors cursor-pointer"
        data-year="all"
      >
        SEMUA TAHUN
      </button>
      {years.map((year) => (
        <button
          class="year-filter-btn px-3 py-1 text-xs border border-[#262626] bg-black text-[#737373] hover:text-white hover:border-[#737373] font-bold uppercase transition-colors cursor-pointer"
          data-year={year.toString()}
        >
          {year}
        </button>
      ))}
    </div>
  </div>

  <!-- Gallery Grid -->
  <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {photos.map((photo) => (
      <div
        class="gallery-item border border-[#262626] bg-[#0A0A0A] overflow-hidden flex flex-col justify-between hover:border-white transition-colors duration-150 group cursor-pointer"
        data-year={photo.eventYear.toString()}
        data-category={photo.category}
        data-image-url={photo.url}
        data-caption={photo.caption}
        data-event-title={photo.eventTitle}
        data-location={photo.location}
        data-date={photo.eventDate}
      >
        <div>
          <div class="relative aspect-video overflow-hidden bg-black border-b border-[#262626]">
            <img
              src={photo.url}
              alt={photo.caption}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <div
              class="photo-badge absolute top-2 left-2 px-2 py-0.5 border border-[#262626] text-[10px] font-mono font-bold uppercase text-white"
              style="background-color: rgba(0, 0, 0, 0.85) !important; color: #FFFFFF !important;"
            >
              {photo.category}
            </div>
          </div>

          <div class="p-4 font-mono">
            <p class="text-xs text-zinc-100 leading-relaxed mb-3">
              {photo.caption}
            </p>
          </div>
        </div>

        <div class="p-4 pt-0 font-mono text-[10px] text-[#737373] border-t border-[#1a1a1a] flex flex-col gap-1">
          <span class="text-white font-bold truncate uppercase">{photo.eventTitle}</span>
          <span class="truncate">{photo.eventDate} &bull; {photo.location}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Pagination Controls for Expo Gallery (Limit: 9 per page) -->
  <div
    id="gallery-pagination"
    class="mt-8 border border-[#262626] bg-[#0A0A0A] p-3 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs"
  >
    <div class="text-[#737373] text-[11px] flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 bg-white"></span>
      <span>HALAMAN <span id="gallery-page-current" class="text-white font-bold">1</span> / <span id="gallery-page-total" class="text-white font-bold">1</span></span>
      <span class="text-[#444444]">//</span>
      <span id="gallery-page-range" class="text-[#A3A3A3]">MENAMPILKAN 1-9 DARI {photos.length} FOTO</span>
    </div>

    <div class="flex items-center gap-1.5">
      <button
        id="gallery-page-prev"
        type="button"
        class="px-3 py-1.5 border border-[#262626] bg-black text-[#A3A3A3] hover:border-white hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors uppercase font-bold text-xs cursor-pointer"
      >
        &larr; PREV
      </button>

      <div id="gallery-page-numbers" class="flex items-center gap-1">
        <!-- Injected via JS -->
      </div>

      <button
        id="gallery-page-next"
        type="button"
        class="px-3 py-1.5 border border-[#262626] bg-black text-[#A3A3A3] hover:border-white hover:text-white disabled:opacity-30 disabled:pointer-events-none transition-colors uppercase font-bold text-xs cursor-pointer"
      >
        NEXT &rarr;
      </button>
    </div>
  </div>

  <!-- Empty State -->
  <div id="gallery-empty-state" class="hidden border border-[#262626] bg-[#0A0A0A] p-12 text-center font-mono">
    <div class="text-[#737373] text-sm uppercase tracking-widest mb-2">[HASIL TIDAK DITEMUKAN]</div>
    <p class="text-xs text-white max-w-md mx-auto mb-4">
      Tidak ada foto pameran yang cocok dengan filter tahun yang dipilih.
    </p>
    <button
      id="reset-filters-btn"
      class="px-4 py-2 border border-white bg-white text-black font-bold text-xs uppercase hover:bg-black hover:text-white transition-colors cursor-pointer"
    >
      RESET FILTER
    </button>
  </div>
</section>

<!-- Lightbox Modal -->
<div
  id="expo-lightbox"
  class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8"
>
  <div class="relative max-w-5xl w-full border border-[#262626] bg-[#0A0A0A] overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Modal Header -->
    <div id="expo-lightbox-header" class="px-4 py-3 border-b border-[#262626] bg-black flex items-center justify-between font-mono text-xs">
      <div class="flex items-center gap-2">
        <span class="lightbox-dot inline-block w-2 h-2 bg-white"></span>
        <span id="modal-category" class="text-white font-bold uppercase">PREVIEW DOKUMENTASI</span>
      </div>
      <button
        id="close-lightbox-btn"
        class="px-2 py-1 border border-[#262626] text-[#737373] hover:text-white hover:border-white uppercase text-[11px] transition-colors cursor-pointer"
      >
        [TUTUP &times;]
      </button>
    </div>

    <!-- Modal Body -->
    <div class="overflow-y-auto p-4 sm:p-6 space-y-4">
      <div class="relative w-full aspect-16/10 sm:aspect-video bg-black border border-[#262626] overflow-hidden flex items-center justify-center">
        <img
          id="modal-image"
          src=""
          alt=""
          class="max-h-full max-w-full object-contain"
        />
      </div>

      <div class="font-mono space-y-2">
        <h3 id="modal-caption" class="text-sm sm:text-base text-white font-bold leading-relaxed"></h3>
        <div class="flex flex-wrap items-center gap-3 text-xs text-[#737373] pt-2 border-t border-[#1a1a1a]">
          <span id="modal-event" class="text-white font-bold uppercase"></span>
          <span>&bull;</span>
          <span id="modal-location"></span>
          <span>&bull;</span>
          <span id="modal-date"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Interactive Client-side Script for Filtering, Pagination & Lightbox -->
<script is:inline>
  function setupExpoGallery() {
    const yearButtons = document.querySelectorAll('.year-filter-btn');
    const galleryItems = Array.from(document.querySelectorAll('.gallery-item'));
    const counterEl = document.getElementById('gallery-counter');
    const headerPhotoCount = document.getElementById('header-photo-count');
    const emptyState = document.getElementById('gallery-empty-state');
    const resetBtn = document.getElementById('reset-filters-btn');
    const galleryGrid = document.getElementById('gallery-grid');

    // Pagination elements
    const paginationBox = document.getElementById('gallery-pagination');
    const pageCurrentEl = document.getElementById('gallery-page-current');
    const pageTotalEl = document.getElementById('gallery-page-total');
    const pageRangeEl = document.getElementById('gallery-page-range');
    const pagePrevBtn = document.getElementById('gallery-page-prev');
    const pageNextBtn = document.getElementById('gallery-page-next');
    const pageNumbersEl = document.getElementById('gallery-page-numbers');

    const PAGE_SIZE = 9;
    let currentPage = 1;
    let selectedYear = 'all';

    // Lightbox elements
    const lightbox = document.getElementById('expo-lightbox');
    const modalImage = document.getElementById('modal-image');
    const modalCaption = document.getElementById('modal-caption');
    const modalCategory = document.getElementById('modal-category');
    const modalEvent = document.getElementById('modal-event');
    const modalLocation = document.getElementById('modal-location');
    const modalDate = document.getElementById('modal-date');
    const closeLightboxBtn = document.getElementById('close-lightbox-btn');

    function applyFilters(resetPage = true) {
      if (resetPage) currentPage = 1;

      // Filter matching items
      const matchingItems = galleryItems.filter((item) => {
        const itemYear = item.getAttribute('data-year');
        return selectedYear === 'all' || itemYear === selectedYear;
      });

      const totalMatching = matchingItems.length;
      const totalPages = Math.ceil(totalMatching / PAGE_SIZE) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * PAGE_SIZE;
      const endIndex = Math.min(startIndex + PAGE_SIZE, totalMatching);

      // Hide all items first
      galleryItems.forEach((item) => item.classList.add('hidden'));

      // Show paginated matching items
      matchingItems.slice(startIndex, endIndex).forEach((item) => {
        item.classList.remove('hidden');
      });

      if (counterEl) counterEl.textContent = totalMatching.toString();
      if (headerPhotoCount) headerPhotoCount.textContent = `${totalMatching} DOKUMEN`;

      if (emptyState) {
        if (totalMatching === 0) {
          emptyState.classList.remove('hidden');
          if (galleryGrid) galleryGrid.classList.add('hidden');
          if (paginationBox) paginationBox.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          if (galleryGrid) galleryGrid.classList.remove('hidden');
          if (paginationBox) {
            if (totalPages <= 1) {
              paginationBox.classList.add('hidden');
            } else {
              paginationBox.classList.remove('hidden');
            }
          }
        }
      }

      // Update pagination readouts
      if (pageCurrentEl) pageCurrentEl.textContent = String(currentPage);
      if (pageTotalEl) pageTotalEl.textContent = String(totalPages);
      if (pageRangeEl) {
        pageRangeEl.textContent = totalMatching > 0
          ? `MENAMPILKAN ${startIndex + 1}-${endIndex} DARI ${totalMatching} FOTO`
          : 'MENAMPILKAN 0 FOTO';
      }

      if (pagePrevBtn) pagePrevBtn.disabled = currentPage <= 1;
      if (pageNextBtn) pageNextBtn.disabled = currentPage >= totalPages;

      // Render page numbers
      if (pageNumbersEl) {
        pageNumbersEl.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i).padStart(2, '0');
          const isCurrent = i === currentPage;
          btn.className = isCurrent
            ? 'px-2.5 py-1 text-xs font-bold border border-white bg-white text-black'
            : 'px-2.5 py-1 text-xs border border-[#262626] bg-black text-[#A3A3A3] hover:border-white hover:text-white transition-colors cursor-pointer';
          btn.addEventListener('click', () => {
            currentPage = i;
            applyFilters(false);
            const section = document.getElementById('photo-gallery');
            if (section) {
              window.scrollTo({ top: section.offsetTop - 80, behavior: 'smooth' });
            }
          });
          pageNumbersEl.appendChild(btn);
        }
      }
    }

    function updateActiveButtons() {
      yearButtons.forEach((btn) => {
        const val = btn.getAttribute('data-year');
        if (val === selectedYear) {
          btn.className = 'year-filter-btn px-3 py-1 text-xs border border-white bg-white text-black font-bold uppercase transition-colors cursor-pointer';
        } else {
          btn.className = 'year-filter-btn px-3 py-1 text-xs border border-[#262626] bg-black text-[#737373] hover:text-white hover:border-[#737373] font-bold uppercase transition-colors cursor-pointer';
        }
      });
    }

    yearButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedYear = btn.getAttribute('data-year') || 'all';
        updateActiveButtons();
        applyFilters(true);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        selectedYear = 'all';
        updateActiveButtons();
        applyFilters(true);
      });
    }

    pagePrevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        applyFilters(false);
        const section = document.getElementById('photo-gallery');
        if (section) {
          window.scrollTo({ top: section.offsetTop - 80, behavior: 'smooth' });
        }
      }
    });

    pageNextBtn?.addEventListener('click', () => {
      const matchingCount = galleryItems.filter((item) => {
        const itemYear = item.getAttribute('data-year');
        return selectedYear === 'all' || itemYear === selectedYear;
      }).length;
      const totalPages = Math.ceil(matchingCount / PAGE_SIZE) || 1;
      if (currentPage < totalPages) {
        currentPage++;
        applyFilters(false);
        const section = document.getElementById('photo-gallery');
        if (section) {
          window.scrollTo({ top: section.offsetTop - 80, behavior: 'smooth' });
        }
      }
    });

    // Initial render
    applyFilters(true);

    // Lightbox handlers
    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        const imgUrl = item.getAttribute('data-image-url') || '';
        const caption = item.getAttribute('data-caption') || '';
        const category = item.getAttribute('data-category') || '';
        const eventTitle = item.getAttribute('data-event-title') || '';
        const location = item.getAttribute('data-location') || '';
        const date = item.getAttribute('data-date') || '';

        if (modalImage) modalImage.src = imgUrl;
        if (modalCaption) modalCaption.textContent = caption;
        if (modalCategory) modalCategory.textContent = category;
        if (modalEvent) modalEvent.textContent = eventTitle;
        if (modalLocation) modalLocation.textContent = location;
        if (modalDate) modalDate.textContent = date;

        if (lightbox) {
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    if (closeLightboxBtn) {
      closeLightboxBtn.addEventListener('click', closeLightbox);
    }

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    });
  }

  setupExpoGallery();
  document.addEventListener('astro:after-swap', setupExpoGallery);
</script>
